# ---------------- Core ----------------
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=./data
SEED_ONTOLOGY_PATH=./app/seed/dblp_minimal.ttl

# ---------------- LiteLLM / LLM ----------------
# LiteLLM proxy example: http://localhost:4000/v1
LITELLM_API_BASE=http://localhost:4000/v1
LITELLM_API_KEY=
# Use the model name understood by your LiteLLM deployment.
LITELLM_MODEL=openai/gpt-5.2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=

# Optional direct provider credentials if your LiteLLM setup forwards them from env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---------------- Agent / context limits ----------------
MAX_AGENT_STEPS=16
MAX_EVIDENCE_SPANS=16
MAX_EVIDENCE_CHARS=30000
MAX_TOOL_OUTPUT_CHARS=20000
ENABLE_AGENT_BASH=false
AGENT_SHELL_TIMEOUT_SECONDS=20

# ---------------- PDF / retrieval ----------------
PDF_MAX_PAGES=200
LEXICAL_TOP_K=12
CONTEXT_EXPANSION_PARAGRAPHS=2

# ---------------- Ontology ----------------
# Optional remote/alternative seed path can be downloaded manually and configured here.
DBLP_ONTOLOGY_URL=
ALLOW_ONTOLOGY_EXTENSIONS=true
SHACL_STRICT=false

# ---------------- Upstream EDC (optional experimental adapter) ----------------
EDC_UPSTREAM_PATH=

# ---------------- Observability (optional) ----------------
LANGTRACE_API_KEY=
LANGTRACE_API_HOST="https://omen-server.tail5e5a2f.ts.net/api/trace"
LOGFIRE_TOKEN=
ENABLE_LANGTRACE=false
ENABLE_LOGFIRE=false
LANGTRACE_BATCH=false
LANGTRACE_CAPTURE_CONTENT=true

# ---------------- Evaluation (optional) ----------------
# DeepEval can use provider env vars above, or Confident AI if desired.
CONFIDENT_API_KEY=
ENABLE_LLM_EVAL=false

# ---------------- Frontend ----------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
